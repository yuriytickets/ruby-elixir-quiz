<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= h(@title ? "#{@title} · Interview Prep" : "Ruby & Elixir Interview Prep") %></title>
<style>
:root { --bg:#fff; --fg:#1a1a1a; --muted:#666; --line:#e3e3e3; --card:#f7f7f8; --accent:#8e1a3b; --ok:#1d7a3a; --bad:#b3261e; --code:#f3f3f5; }
@media (prefers-color-scheme: dark) {
  :root { --bg:#141417; --fg:#e8e8ea; --muted:#9a9aa3; --line:#2b2b31; --card:#1d1d22; --accent:#e06b8b; --ok:#5ccf7a; --bad:#ff6b63; --code:#1a1a1f; }
  .highlight { filter: invert(0.92) hue-rotate(180deg); }
}
* { box-sizing: border-box; }
body { margin:0; background:var(--bg); color:var(--fg); font:16px/1.55 -apple-system, BlinkMacSystemFont, "Segoe UI", Helvetica, Arial, sans-serif; }
nav { display:flex; gap:14px; flex-wrap:wrap; align-items:center; padding:12px 16px; border-bottom:1px solid var(--line); }
nav a { color:var(--fg); text-decoration:none; font-weight:500; }
nav a.brand { color:var(--accent); font-weight:700; margin-right:8px; }
nav a:hover { text-decoration:underline; }
main { max-width: 960px; margin: 0 auto; padding: 20px 16px 60px; }
h1 { font-size:1.6rem; margin:.4em 0 .6em; }
h2 { font-size:1.2rem; margin:1.2em 0 .5em; }
h3 { font-size:1rem; margin:1em 0 .4em; }
a { color: var(--accent); }
.muted { color: var(--muted); }
.crumbs { font-size:.9rem; color:var(--muted); }
.badge { display:inline-block; font-size:.75rem; padding:1px 8px; border-radius:10px; background:var(--card); border:1px solid var(--line); margin-left:4px; }
.badge.junior { border-color:var(--ok); } .badge.middle { border-color:#c98a00; } .badge.senior { border-color:var(--bad); }
.card { background:var(--card); border:1px solid var(--line); border-radius:10px; padding:14px 16px; margin:12px 0; }
.grid { display:grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 14px; }
.stats { display:flex; gap:18px; flex-wrap:wrap; margin:6px 0 10px; }
.stat b { display:block; font-size:1.5rem; }
.stat span { font-size:.8rem; color:var(--muted); }
table { width:100%; border-collapse:collapse; font-size:.92rem; }
th, td { text-align:left; padding:6px 8px; border-bottom:1px solid var(--line); vertical-align:top; }
th { color:var(--muted); font-weight:600; font-size:.8rem; text-transform:uppercase; letter-spacing:.03em; }
tr.weak td:first-child a { color: var(--bad); font-weight:600; }
.btn, button { display:inline-block; font:inherit; padding:7px 14px; border-radius:7px; border:1px solid var(--line); background:var(--card); color:var(--fg); cursor:pointer; text-decoration:none; }
.btn.primary, button.primary { background:var(--accent); color:#fff; border-color:var(--accent); }
.btn:hover, button:hover { filter: brightness(1.08); }
form.filters { display:flex; gap:8px; flex-wrap:wrap; align-items:center; margin: 8px 0 14px; }
select, input[type=text] { font:inherit; padding:6px 8px; border:1px solid var(--line); border-radius:6px; background:var(--bg); color:var(--fg); }
.md pre, pre.output { background:var(--code); border:1px solid var(--line); border-radius:8px; padding:10px 12px; overflow:auto; font-size:.88rem; line-height:1.45; }
.md code, li code { background:var(--code); padding:1px 5px; border-radius:4px; font-size:.9em; }
.md pre code { background:none; padding:0; }
.md blockquote { border-left:3px solid var(--line); margin:0; padding:2px 12px; color:var(--muted); }
ol.choices { list-style: upper-alpha; padding-left: 28px; }
ol.choices li { padding:6px 8px; margin:4px 0; border-radius:6px; border:1px solid transparent; }
ol.choices li label { cursor:pointer; display:block; }
ol.choices li.right { border-color:var(--ok); background: color-mix(in srgb, var(--ok) 12%, transparent); }
ol.choices li.wrong { border-color:var(--bad); background: color-mix(in srgb, var(--bad) 12%, transparent); }
.verdict { font-weight:600; font-size:1.1rem; }
.verdict.ok { color:var(--ok); } .verdict.bad { color:var(--bad); }
textarea.code { width:100%; font: 14px/1.45 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; padding:10px; border:1px solid var(--line); border-radius:8px; background:var(--code); color:var(--fg); tab-size:2; resize:vertical; }
pre.output.pass { border-color:var(--ok); } pre.output.fail { border-color:var(--bad); }
.answer { border-left:3px solid var(--accent); padding-left:14px; margin:12px 0; }
.grades button { margin-right:6px; }
.actions { display:flex; gap:10px; align-items:center; margin:18px 0; flex-wrap:wrap; }
.bars { display:flex; gap:3px; align-items:flex-end; height:60px; margin:6px 0; }
.bars div { flex:1; background:var(--accent); min-height:2px; border-radius:2px 2px 0 0; opacity:.85; }
.history li { font-size:.88rem; color:var(--muted); }
.notice { padding:10px 14px; border:1px solid var(--line); border-radius:8px; background:var(--card); }
</style>
<style><%= rouge_css %></style>
</head>
<body>
<nav>
  <a class="brand" href="/">Interview Prep</a>
  <a href="/items">Browse</a>
  <a href="/study?language=ruby">Study Ruby</a>
  <a href="/study?language=elixir">Study Elixir</a>
  <a href="/interview/ruby">Mock interview: Ruby</a>
  <a href="/interview/elixir">Mock interview: Elixir</a>
</nav>
<main><%= yield %></main>
<script>
document.querySelectorAll("textarea.code").forEach(t => t.addEventListener("keydown", e => {
  if (e.key === "Tab") { e.preventDefault(); t.setRangeText("  ", t.selectionStart, t.selectionEnd, "end"); }
  if (e.key === "Enter" && (e.metaKey || e.ctrlKey)) t.form.requestSubmit();
}));
</script>
</body>
</html>
