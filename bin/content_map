#!/usr/bin/env ruby
# frozen_string_literal: true

# Regenerates docs/content-map.md from content/**/*.yml. Stdlib only.
require "yaml"

root = File.expand_path("..", __dir__)
langs = Hash.new { |h, k| h[k] = [] }
Dir[File.join(root, "content/*/*.yml")].sort.each do |f|
  d = YAML.safe_load_file(f)
  items = d["items"]
  langs[d["language"]] << [d["topic"], items.size, items.map { _1["kind"] }.tally, items.map { _1["difficulty"] }.tally]
end

out = ["# Content map", "", "Generated by `bin/content_map` from `content/**/*.yml`.", ""]
langs.sort.each do |lang, rows|
  out << "## #{lang.capitalize}: #{rows.sum { _2 }} items" << ""
  out << "| Topic | Items | mcq | open | code | theory | junior | middle | senior |"
  out << "|---|---|---|---|---|---|---|---|---|"
  rows.each do |t, n, k, d|
    cells = [t, n] + %w[mcq open code theory].map { k[_1] || 0 } + %w[junior middle senior].map { d[_1] || 0 }
    out << "| #{cells.join(' | ')} |"
  end
  out << ""
end
out << "## Kinds" << ""
out << "- **mcq**: one correct choice, auto-graded."
out << "- **open**: answer out loud, reveal the model answer, self-grade (feeds spaced repetition)."
out << "- **code**: write the solution in the browser; it runs against bundled Minitest / ExUnit tests."
out << "- **theory**: a short lesson card with a recap question."
out << ""
out << "Every `code` item ships a reference solution that `bin/validate_content` executes, so the whole bank is known-solvable."
File.write(File.join(root, "docs/content-map.md"), out.join("\n") + "\n")
puts "wrote docs/content-map.md (#{langs.values.flatten(1).sum { _2 }} items)"
